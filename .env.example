# Langes Zufalls-Token, z. B.: openssl rand -hex 32
MCP_TOKEN=

# Pflicht laut https://transitous.org/api/: App-Name, Version und Kontakt (E-Mail oder URL)
TRANSITOUS_USER_AGENT=transitwalter/0.1 (Kontakt: …)

# Öffentliche Adresse für Karten- und GPX-Links (ohne / am Ende)
PUBLIC_BASE_URL=https://transitwalter.example.org

# Persönliche Standards, pro Aufruf überschreibbar
WALK_SPEED_KMH=5.5
MAX_WALK_MINUTES=30

# Eigenes Limit für Anfragen an Transitous (Cache-Treffer zählen nicht)
TRANSITOUS_REQUESTS_PER_MINUTE=20

# DB-Preise (inoffizielle DB-Navigator-Schnittstelle): die DB blockt manche User-Agents (z. B. mit URL)
# und drosselt schnell – deshalb ein niedriges eigenes Limit
DB_USER_AGENT=transitwalter/0.1
DB_REQUESTS_PER_MINUTE=10
